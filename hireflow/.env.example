# Copy to .env and fill in. NEVER commit .env or paste keys into code or the notebook.
# Leave everything empty to run with the template sentence only.

# Free key: https://aistudio.google.com/  (Gemini)
GEMINI_API_KEY=
# Free key: https://console.groq.com/  (Groq)
GROQ_API_KEY=

# Optional local model: install Ollama, run `ollama pull qwen2.5:3b`, then set OLLAMA_ENABLED=1
OLLAMA_ENABLED=0

# Optional overrides (model names can change; check the provider's docs)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_MODEL=qwen2.5:3b

# Force the template sentence (no model calls at all): HIREFLOW_LLM=off
HIREFLOW_LLM=auto
